{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "image-emotion-subtask.schema.json",
  "title": "Image Emotion Recognition Implementation Subtask",
  "type": "object",
  "required": [
    "id",
    "title",
    "goal",
    "inputs",
    "outputs",
    "acceptance_criteria",
    "depends_on",
    "priority",
    "implementation_notes"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{3}_[a-z0-9_]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{3}_[a-z0-9_]+$"
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "required",
        "conditional"
      ]
    },
    "implementation_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
