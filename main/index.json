{
  "project": "image_emotion_recognition_main_24gb_ensemble_plan",
  "version": "2026-06-05",
  "schema": "schema.json",
  "goal": "在 24GB 显存约束下，以中型强模型冻结特征、多模型 5 折 OOF 融合、少数类专家和安全伪标签为核心，冲击图像情感识别比赛最高 Macro-F1。",
  "hardware_constraints": {
    "approved_gpu_memory_gb": 24,
    "known_baseline_memory": [
      "Cambrian 特征提取 batch_size=1 约 4GB 显存。",
      "Cambrian head 训练 batch_size=16 约 1GB 显存。"
    ],
    "strategy": "默认不全量微调大视觉骨干；所有候选模型优先 eval/no_grad/fp16 或 bf16 缓存特征，再训练轻量 head。"
  },
  "model_pool": {
    "primary": [
      {
        "id": "pe_core_l14_336",
        "model": "facebook/PE-Core-L14-336",
        "role": "CLIP-like 语义主力，替代更大的 CLIP 系路线。"
      },
      {
        "id": "dinov3_vitl16",
        "model": "facebook/dinov3-vitl16-pretrain-lvd1689m",
        "role": "场景、构图和非语言化视觉表征主力。"
      },
      {
        "id": "internvit_300m_448",
        "model": "OpenGVLab/InternViT-300M-448px",
        "role": "高分辨率细节互补，作为 InternViT-6B 的 24GB 可行替代。"
      },
      {
        "id": "eva02_clip_l14_336",
        "model": "EVA02-CLIP-L-14-336 或可用等价 checkpoint",
        "role": "EVA 系互补，替代 EVA-CLIP-18B。"
      }
    ],
    "secondary": [
      {
        "id": "dinov3_convnext_l",
        "model": "DINOv3 ConvNeXt-L 或 timm ConvNeXtV2-L 384",
        "role": "局部纹理、色彩和主体细节互补。"
      },
      {
        "id": "existing_cambrian_siglip_openclip",
        "model": "当前已跑通的 Cambrian/SigLIP2/OpenCLIP 候选输出",
        "role": "作为融合基线与历史最强 73 分锚点。"
      }
    ],
    "explicitly_deferred": [
      {
        "model": "EVA-CLIP-18B",
        "reason": "权重和显存成本过高，24GB 下不作为主线；如另有 80GB 级资源，只做冻结特征或 zero-shot 互补。"
      },
      {
        "model": "InternViT-6B",
        "reason": "显存与吞吐成本高，先用 InternViT-300M-448px 获取高分辨率互补。"
      },
      {
        "model": "DINOv3 ViT-H+",
        "reason": "可作为最后条件任务尝试 batch_size=1 特征缓存，但不阻塞主路线。"
      }
    ]
  },
  "global_constraints": [
    "使用 Conda 环境 dl 运行 Python、训练、推理和测试命令。",
    "主指标为 Macro-F1，Accuracy 仅作辅助。",
    "训练集 3018 张，测试集 1391 张，类别为 amusement、anger、awe、contentment、disgust、excitement、fear、sadness。",
    "所有图像加载必须 convert('RGB')。",
    "测试集提交必须按 1.jpg 到 1391.jpg 的数字自然序输出，每行一个合法标签。",
    "默认不全量微调大视觉骨干；先缓存冻结特征，再训练 head、OOF 融合、专家和伪标签。",
    "新增策略必须通过同一 OOF 或同一验证协议证明收益后才能进入最终提交。"
  ],
  "score_targets": {
    "current_anchor": "Cambrian 融合 head 约 73 分。",
    "expected_mainline": "5 折 OOF 多模型融合后目标 76.5-78.5。",
    "expected_with_tta_and_experts": "加入高分辨率 TTA、类别校准和少数类专家后目标 78.5-80。",
    "stretch_with_pseudolabel": "伪标签成功时冲刺 79-81。"
  },
  "phases": [
    {
      "name": "foundation",
      "description": "建立可复现数据、划分、指标、提交和实验记录底座。",
      "task_ids": [
        "001_project_foundation",
        "002_data_split_and_audit",
        "003_metric_submission_contract"
      ]
    },
    {
      "name": "feature_backbones",
      "description": "在 24GB 显存下顺序缓存各候选模型冻结特征。",
      "task_ids": [
        "004_feature_cache_framework",
        "005_cache_pe_core_features",
        "006_cache_dinov3_vitl_features",
        "007_cache_internvit300m_features",
        "008_cache_eva02_clip_features",
        "009_cache_convnext_features",
        "010_import_existing_candidates"
      ]
    },
    {
      "name": "single_model_screening",
      "description": "对每个特征源训练轻量 head 并筛选保留模型。",
      "task_ids": [
        "011_train_single_feature_heads",
        "012_single_model_error_analysis"
      ]
    },
    {
      "name": "route_b_oof_fusion",
      "description": "执行 5 折 OOF 训练和概率融合。",
      "task_ids": [
        "013_build_fivefold_oof_features",
        "014_train_oof_heads",
        "015_oof_probability_fusion"
      ]
    },
    {
      "name": "route_c_tta_calibration",
      "description": "对高价值模型启用温和 TTA 和类别级概率校准。",
      "task_ids": [
        "016_tta_probability_generation",
        "017_macro_f1_calibration"
      ]
    },
    {
      "name": "route_d_tail_experts",
      "description": "训练少数类和易混淆类别专家，按置信门控覆盖主模型。",
      "task_ids": [
        "018_tail_confusion_experts",
        "019_expert_override_gate"
      ]
    },
    {
      "name": "pseudolabel_and_final",
      "description": "在最终冲刺阶段使用安全伪标签并生成最终提交。",
      "task_ids": [
        "020_safe_pseudolabel_selection",
        "021_retrain_with_pseudolabels",
        "022_final_model_selection",
        "023_final_submission_package"
      ]
    },
    {
      "name": "optional_large_model_probe",
      "description": "不阻塞主线的条件探索任务。",
      "task_ids": [
        "024_optional_dinov3_vith_probe"
      ]
    }
  ],
