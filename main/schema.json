{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "main-image-emotion-task.schema.json",
  "title": "Main Image Emotion Recognition Distributed Task",
  "type": "object",
  "required": [
    "id",
    "title",
    "goal",
    "inputs",
    "outputs",
    "execution_steps",
    "acceptance_criteria",
    "depends_on",
    "priority",
    "resource_profile",
    "implementation_notes"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{3}_[a-z0-9_]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{3}_[a-z0-9_]+$"
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "required",
        "recommended",
        "conditional"
      ]
    },
    "resource_profile": {
      "type": "object",
      "required": [
        "gpu_memory_gb",
        "batch_size_hint",
        "runtime_notes"
      ],
      "additionalProperties": false,
      "properties": {
        "gpu_memory_gb": {
          "type": "string",
          "minLength": 1
        },
        "batch_size_hint": {
          "type": "string",
          "minLength": 1
        },
        "runtime_notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "implementation_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
